{
  "name": "homehelp-ionic-angular",
  "version": "1.0.0",
  "private": true,
  "description": "HomeHelp Ionic + Angular app with Capacitor Android support",
  "scripts": {
    "ng": "ng",
    "start": "IONIC_CONFIG_DIRECTORY=.ionic npx ionic serve --no-open --host=127.0.0.1 --port=8100",
    "serve": "ng serve --host=127.0.0.1 --port=8100 --open=false",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "ionic": "IONIC_CONFIG_DIRECTORY=.ionic npx ionic",
    "android:add": "npx cap add android",
    "android:build": "npm run build && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:assets": "capacitor-assets generate --android --iconBackgroundColor '#4F46E5' --splashBackgroundColor '#4F46E5' --splashBackgroundColorDark '#0F172A' --logoSplashScale 0.42",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android"
  },
  "dependencies": {
    "@angular/animations": "^17.3.0",
    "@angular/common": "^17.3.0",
    "@angular/compiler": "^17.3.0",
    "@angular/core": "^17.3.0",
    "@angular/forms": "^17.3.0",
    "@angular/platform-browser": "^17.3.0",
    "@angular/platform-browser-dynamic": "^17.3.0",
    "@angular/router": "^17.3.0",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.2.0",
    "@capacitor/push-notifications": "^6.0.5",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@ionic/angular": "^8.0.0",
    "ionicons": "^7.4.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.6.2",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0",
    "@ionic/angular-toolkit": "^11.0.1",
    "@ionic/cli": "^7.2.1",
    "@types/jasmine": "~5.1.4",
    "jasmine-core": "~5.1.1",
    "karma": "~6.4.3",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.5"
  }
}
